# ============================================================
# SOCIALSYNC AI — MASTER DEPLOYMENT ENVIRONMENT TEMPLATE
# ============================================================
# Copy this file to:
#   - backend/.env (for backend server configuration)
# Fill in real credentials. Never commit real credentials or .env files to Git.

# ------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION (REQUIRED)
# ------------------------------------------------------------
PORT=5002
NODE_ENV=production
APP_TIMEZONE=Asia/Colombo

# Base URLs for CORS and callback construction
# In production on a VM, set these to your domain or public IP (e.g., https://socialsync.example.com)
FRONTEND_URL=http://localhost:5180
BACKEND_URL=http://localhost:5002
BACKEND_PUBLIC_URL=http://localhost:5002

# ------------------------------------------------------------
# 2. DATABASE CONFIGURATION (REQUIRED)
# ------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://<username>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://postgres:<your_db_password>@localhost:5432/socialflow_db?schema=public"

# ------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (REQUIRED)
# ------------------------------------------------------------
# Cryptographically strong secret key for JWT session tokens (min 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<generate_a_secure_random_jwt_secret_here>

# ------------------------------------------------------------
# 4. MEDIA STORAGE & FILE UPLOADS (REQUIRED)
# ------------------------------------------------------------
# Storage engine: local | s3 | r2 (default: local)
STORAGE_TYPE=local
UPLOAD_DIR=uploads

# ------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL & SMTP (RECOMMENDED FOR PRODUCTION)
# ------------------------------------------------------------
# Used for password reset verification emails and system notifications
# Supports Gmail App Passwords, SendGrid, Resend, Amazon SES, Mailgun, Postmark, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<your_smtp_username_or_email>
SMTP_PASS=<your_smtp_app_password>
SMTP_FROM="SocialSync AI <no-reply@socialsync.ai>"

# ------------------------------------------------------------
# 6. GOOGLE OAUTH 2.0 / OIDC AUTHENTICATION (OPTIONAL)
# ------------------------------------------------------------
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript Origins: <FRONTEND_URL>
# Authorized Redirect URI: <BACKEND_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=<your_google_client_id>
GOOGLE_CLIENT_SECRET=<your_google_client_secret>
GOOGLE_AUTH_REDIRECT_URI=http://localhost:5002/api/auth/google/callback

# ------------------------------------------------------------
# 7. SOCIAL PLATFORM PUBLISHING INTEGRATIONS (OPTIONAL)
# ------------------------------------------------------------
# If left blank, SocialSync AI displays "Configuration Required" in the UI
# without failing or interrupting other platform connections.

# Meta / Facebook Graph API v20.0+ (https://developers.facebook.com)
FACEBOOK_CLIENT_ID=<your_facebook_app_id>
FACEBOOK_CLIENT_SECRET=<your_facebook_app_secret>
FACEBOOK_REDIRECT_URI=http://localhost:5002/api/oauth/facebook/callback
FACEBOOK_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,public_profile

# Instagram Graph API (Professional / Creator Accounts)
INSTAGRAM_CLIENT_ID=<your_instagram_app_id>
INSTAGRAM_CLIENT_SECRET=<your_instagram_app_secret>
INSTAGRAM_REDIRECT_URI=http://localhost:5002/api/oauth/instagram/callback
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish

# LinkedIn REST API / OAuth 2.0 (https://www.linkedin.com/developers)
LINKEDIN_CLIENT_ID=<your_linkedin_client_id>
LINKEDIN_CLIENT_SECRET=<your_linkedin_client_secret>
LINKEDIN_REDIRECT_URI=http://localhost:5002/api/oauth/linkedin/callback
LINKEDIN_SCOPES=openid profile email w_member_social
LINKEDIN_API_VERSION=202601

# Threads API (https://developers.facebook.com/docs/threads)
THREADS_CLIENT_ID=<your_threads_app_id>
THREADS_CLIENT_SECRET=<your_threads_app_secret>
THREADS_REDIRECT_URI=http://localhost:5002/api/oauth/threads/callback

# TikTok for Developers (https://developers.tiktok.com)
TIKTOK_CLIENT_KEY=<your_tiktok_client_key>
TIKTOK_CLIENT_SECRET=<your_tiktok_client_secret>
TIKTOK_REDIRECT_URI=http://localhost:5002/api/oauth/tiktok/callback
TIKTOK_SCOPES=user.info.basic,video.publish,video.upload

# YouTube Data API v3 (Google APIs Console)
YOUTUBE_CLIENT_ID=<your_youtube_google_client_id>
YOUTUBE_CLIENT_SECRET=<your_youtube_google_client_secret>
YOUTUBE_REDIRECT_URI=http://localhost:5002/api/oauth/youtube/callback
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube.readonly openid email profile

# ------------------------------------------------------------
# 8. PAYHERE PAYMENT GATEWAY & SUBSCRIPTIONS (OPTIONAL)
# ------------------------------------------------------------
# Portal: https://sandbox.payhere.lk (or https://www.payhere.lk for Live)
PAYHERE_MERCHANT_ID=<your_payhere_merchant_id>
PAYHERE_MERCHANT_SECRET=<your_payhere_merchant_secret>
PAYHERE_SANDBOX=true

# Server-to-server Instant Payment Notification (IPN) webhook URL
# MUST be publicly accessible via HTTPS (PayHere servers cannot reach localhost)
# Example: https://your-domain.com/api/webhooks/payment
PAYHERE_NOTIFY_URL=https://<your_public_domain_or_tunnel>/api/webhooks/payment

# PayHere Subscription Manager / Automated Charging API (Optional)
PAYHERE_APP_ID=<your_payhere_app_id>
PAYHERE_APP_SECRET=<your_payhere_app_secret>

# ------------------------------------------------------------
# 9. AI VISION & CAPTION GENERATION (OPTIONAL)
# ------------------------------------------------------------
GEMINI_API_KEY=<your_gemini_api_key>
GEMINI_VISION_MODEL=gemini-3-flash-preview

OPENAI_API_KEY=<your_openai_api_key>
OPENAI_VISION_MODEL=gpt-4o-mini
