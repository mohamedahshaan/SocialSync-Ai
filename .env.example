# ============================================================
# SOCIALFLOW AI — ENVIRONMENT VARIABLES CONFIGURATION
# ============================================================

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/socialflow_db?schema=public"

# Backend Server Configuration
PORT=5001
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_change_in_production_socialflow_ai_2026
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001

# Storage Configuration (local | s3 | cloudinary | r2)
STORAGE_TYPE=local
UPLOAD_DIR=uploads

# n8n Automation Engine Configuration
ORCHESTRATION_MODE=n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook/socialflow-publish
N8N_API_KEY=socialflow_n8n_secret_token_secure_2026

# ------------------------------------------------------------
# OFFICIAL OAUTH & PLATFORM CREDENTIALS
# (Leave blank or set to your developer portal values.
# If left blank, SocialFlow AI displays "Configuration Required"
# instead of failing or creating fake connections)
# ------------------------------------------------------------

# Meta / Facebook Developer App (Graph API v20.0+)
# Portal: https://developers.facebook.com
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:5001/api/oauth/facebook/callback

# Instagram Graph API
# Portal: https://developers.facebook.com/products/instagram
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:5001/api/oauth/instagram/callback

# LinkedIn Developer Portal (OAuth 2.0 / REST API)
# Portal: https://www.linkedin.com/developers
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5001/api/oauth/linkedin/callback
LINKEDIN_SCOPES=openid profile email w_member_social
LINKEDIN_API_VERSION=202601

# X / Twitter Developer Portal (API v2 with PKCE)
# Portal: https://developer.x.com
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:5001/api/oauth/x/callback

# Threads API
# Portal: https://developers.facebook.com/docs/threads
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=http://localhost:5001/api/oauth/threads/callback

# TikTok for Developers (Content Posting API v2 / Login Kit)
# Portal: https://developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:5001/api/oauth/tiktok/callback
TIKTOK_SCOPES=user.info.basic,video.publish,video.upload
