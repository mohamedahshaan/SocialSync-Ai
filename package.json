{
  "name": "socialflow-ai",
  "version": "1.0.0",
  "description": "SocialFlow AI — Create Once. Publish Everywhere. Multi-user social media management SaaS.",
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:frontend",
    "test": "cd backend && npm test",
    "prisma:generate": "cd backend && npx prisma generate",
    "prisma:push": "cd backend && npx prisma db push"
  },
  "keywords": [
    "social-media",
    "saas",
    "oauth",
    "n8n",
    "automation",
    "publishing",
    "facebook",
    "instagram",
    "linkedin",
    "x",
    "threads"
  ],
  "author": "SocialFlow AI Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
