              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"platform\": \"TIKTOK\",\n  \"socialAccountId\": \"{{ $json.socialAccountId }}\"\n}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "11",
      "name": "TikTok Official Publisher",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1360, 660],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://localhost:5001/api/posts/{{ $('Webhook Trigger').item.json.body.postId }}/publish-result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-socialflow-secret",
              "value": "socialflow_n8n_secret_token_secure_2026"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"platform\": \"{{ $json.data?.platform || $json.platform }}\",\n  \"status\": \"{{ $json.data?.status || ($json.error ? 'FAILED' : 'PUBLISHED') }}\",\n  \"platformPostId\": \"{{ $json.data?.platformPostId || '' }}\",\n  \"errorMessage\": \"{{ $json.data?.errorMessage || $json.error?.message || '' }}\",\n  \"executionId\": \"{{ $execution.id }}\"\n}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "12",
      "name": "Update Backend Callback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1680, 360]
    }
  ],
  "connections": {
