          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"platform\": \"LINKEDIN\",\n  \"socialAccountId\": \"{{ $json.socialAccountId }}\"\n}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "8",
      "name": "LinkedIn Official Publisher",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1360, 300],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://localhost:5001/api/posts/internal/{{ $('Webhook Trigger').item.json.body.postId }}/publish-platform",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-socialflow-secret",
              "value": "socialflow_n8n_secret_token_secure_2026"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"platform\": \"X\",\n  \"socialAccountId\": \"{{ $json.socialAccountId }}\"\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "9",
      "name": "X Official Publisher",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1360, 420],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://localhost:5001/api/posts/internal/{{ $('Webhook Trigger').item.json.body.postId }}/publish-platform",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-socialflow-secret",
