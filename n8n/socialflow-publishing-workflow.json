            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"platform\": \"THREADS\",\n  \"socialAccountId\": \"{{ $json.socialAccountId }}\"\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "10",
      "name": "Threads Official Publisher",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1360, 540],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://localhost:5001/api/posts/internal/{{ $('Webhook Trigger').item.json.body.postId }}/publish-platform",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-socialflow-secret",
