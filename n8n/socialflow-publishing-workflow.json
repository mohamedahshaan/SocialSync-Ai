{
  "name": "SocialFlow AI Multi-Platform Publishing Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "socialflow-publish",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "1",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 320],
      "webhookId": "socialflow-publish-trigger"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body?.postId }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "2",
      "name": "Validate Job Payload",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [420, 320]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://localhost:5001/api/posts/internal/{{ $('Webhook Trigger').item.json.body.postId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-socialflow-secret",
              "value": "socialflow_n8n_secret_token_secure_2026"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "3",
      "name": "Fetch Post Data from Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [640, 320]
    },
    {
      "parameters": {
        "fieldToSplitOut": "data.platforms",
        "options": {}
      },
      "id": "4",
      "name": "Split Platforms",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 1,
      "position": [860, 320]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.platform }}",
        "rules": {
          "rules": [
            { "value2": "FACEBOOK", "output": 0 },
            { "value2": "INSTAGRAM", "output": 1 },
            { "value2": "LINKEDIN", "output": 2 },
            { "value2": "X", "output": 3 },
            { "value2": "THREADS", "output": 4 },
            { "value2": "TIKTOK", "output": 5 }
          ]
        }
      },
      "id": "5",
      "name": "Platform Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [1080, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://localhost:5001/api/posts/internal/{{ $('Webhook Trigger').item.json.body.postId }}/publish-platform",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-socialflow-secret",
              "value": "socialflow_n8n_secret_token_secure_2026"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"platform\": \"FACEBOOK\",\n  \"socialAccountId\": \"{{ $json.socialAccountId }}\"\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "6",
      "name": "Facebook Official Publisher",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1360, 60],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://localhost:5001/api/posts/internal/{{ $('Webhook Trigger').item.json.body.postId }}/publish-platform",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-socialflow-secret",
              "value": "socialflow_n8n_secret_token_secure_2026"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"platform\": \"INSTAGRAM\",\n  \"socialAccountId\": \"{{ $json.socialAccountId }}\"\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "7",
      "name": "Instagram Official Publisher",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1360, 180],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://localhost:5001/api/posts/internal/{{ $('Webhook Trigger').item.json.body.postId }}/publish-platform",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-socialflow-secret",
              "value": "socialflow_n8n_secret_token_secure_2026"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
