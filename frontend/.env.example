# Backend API Base URL (defaults to /api or http://localhost:5002/api)
VITE_API_BASE_URL=http://localhost:5002/api
VITE_BACKEND_URL=http://localhost:5002

# Google OAuth 2.0 Client ID for Sign-In with Google Button
# Portal: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript Origins: http://localhost:5180, http://localhost:5173
VITE_GOOGLE_CLIENT_ID=<your_google_client_id>
