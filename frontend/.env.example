# Backend API Base URL (defaults to /api; in production uses https://socialsync.raccoon-ai.io/api)
VITE_API_BASE_URL=https://socialsync.raccoon-ai.io/api
VITE_BACKEND_URL=https://socialsync.raccoon-ai.io

# Google OAuth 2.0 Client ID for Sign-In with Google Button
# Portal: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript Origins: https://socialsync.raccoon-ai.io, http://localhost:5180, http://localhost:5173
VITE_GOOGLE_CLIENT_ID=<your_google_client_id>
