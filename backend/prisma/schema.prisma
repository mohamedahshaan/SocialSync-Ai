// ============================================================
// SOCIALFLOW AI — PRISMA SCHEMA
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  X
  THREADS
  TIKTOK
  YOUTUBE
}

enum AccountStatus {
  CONNECTED
  DISCONNECTED
  EXPIRED
  CONFIG_REQUIRED
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
}

enum PlatformStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String
  profileImage String?         @default("")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  socialAccounts SocialAccount[]
  posts          Post[]

  @@map("users")
  @@index([email])
}

model SocialAccount {
  id              String        @id @default(cuid())
  userId          String
  platform        Platform
  platformUserId  String        @default("")
  accountName     String
  accountUsername String?
  accessToken     String?       @db.Text
  refreshToken    String?       @db.Text
  tokenExpiresAt  DateTime?
  status          AccountStatus @default(CONNECTED)
  rawProfileData  String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  postPlatforms PostPlatform[]

  @@unique([userId, platform, platformUserId])
  @@map("social_accounts")
  @@index([userId])
}

model Post {
  id          String        @id @default(cuid())
  userId      String
  caption     String        @db.Text
  mediaUrl    String?
  mediaType   String?       @default("NONE") // NONE, IMAGE, VIDEO
  status      PostStatus    @default(DRAFT)
  scheduledAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  platforms      PostPlatform[]
  publishingJobs PublishingJob[]

  @@map("posts")
  @@index([userId])
  @@index([status])
}

model PostPlatform {
  id              String         @id @default(cuid())
  postId          String
  socialAccountId String
  platform        Platform
  status          PlatformStatus @default(PENDING)
  platformPostId  String?
  errorMessage    String?        @db.Text
  publishedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  post          Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([postId, socialAccountId])
  @@map("post_platforms")
  @@index([postId])
  @@index([socialAccountId])
}

model PublishingJob {
  id             String    @id @default(cuid())
  postId         String
  jobId          String    @unique
  idempotencyKey String?   @unique
  executionId    String?
  status         String    @default("PENDING") // PENDING, DISPATCHED, PROCESSING, COMPLETED, FAILED
  payload        String?   @db.Text
  n8nResponse    String?   @db.Text
  errorMessage   String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("publishing_jobs")
  @@index([postId])
  @@index([jobId])
}
