DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/socialflow_db?schema=public"
PORT=5001
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001

STORAGE_TYPE=local
UPLOAD_DIR=uploads


FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:5001/api/oauth/facebook/callback
# Default scopes require a Meta Business app with Page use cases added.
# For testing basic connection before adding Page review permissions, use: public_profile,pages_show_list
FACEBOOK_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,public_profile

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:5001/api/oauth/instagram/callback
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5001/api/oauth/linkedin/callback
LINKEDIN_SCOPES=openid profile email w_member_social
LINKEDIN_API_VERSION=202601

THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=http://localhost:5001/api/oauth/threads/callback

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:5001/api/oauth/tiktok/callback
TIKTOK_SCOPES=user.info.basic,video.publish,video.upload

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5001/api/oauth/youtube/callback
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube.readonly openid email profile

